{
  "name": "pez-terminal-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "perf:ui": "node ../scripts/ui_performance_smoke.mjs",
    "test": "NODE_OPTIONS=--localstorage-file=/tmp/pez-vitest-localstorage-$$ vitest",
    "test:run": "NODE_OPTIONS=--localstorage-file=/tmp/pez-vitest-localstorage-$$ vitest run --testTimeout=15000",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1"
  }
}
